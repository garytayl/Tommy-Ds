# Copy to .env.local and set values. Feature switches turn on when vars are set.
# See lib/config.ts for which vars drive which features.

# -----------------------------------------------------------------------------
# App (optional)
# -----------------------------------------------------------------------------
# Base URL for redirects (Stripe success/cancel, etc.). Falls back to request origin.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# Supabase — enables auth + data (admin/installer, customers, jobs, invoices)
# Set both to turn on features.supabase
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-only Supabase client (signed URLs, webhook writing to DB).
# Set to turn on features.supabaseServiceRole
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe — enables "Collect payment" and checkout
# Set STRIPE_SECRET_KEY to turn on features.stripe
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=

# Optional but recommended: webhook secret so we record payments and update balance.
# Set to turn on features.stripeWebhook (and features.payments with stripe)
# STRIPE_WEBHOOK_SECRET=
