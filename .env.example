# Copy to .env.local and set values. Feature switches turn on when vars are set.
# See lib/config.ts for which vars drive which features.

# -----------------------------------------------------------------------------
# Supabase — enables auth + data (admin/installer, customers, jobs, invoices)
# Set all three so the app can show seed data and new jobs (no login required).
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required to see data: Supabase Dashboard → Project Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY=

# Dev-only: show hover hints in the UI (data source, API, behavior). Never ships — disabled in production.
# NEXT_PUBLIC_DEV_HINTS=true
