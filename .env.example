# Copy to .env.local and set values. Feature switches turn on when vars are set.
# See lib/config.ts for which vars drive which features.

# -----------------------------------------------------------------------------
# App (optional)
# -----------------------------------------------------------------------------
# Base URL for redirects (Stripe success/cancel, etc.). Falls back to request origin.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# Supabase — enables auth + data (admin/installer, customers, jobs, invoices)
# Set all three so the app can show seed data and new jobs (no login required).
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required to see data: Supabase Dashboard → Project Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe — "Collect payment" and checkout (use test keys for demo/sandbox)
# Set STRIPE_SECRET_KEY to turn on features.stripe
# -----------------------------------------------------------------------------
# For demo / sandbox: use TEST keys from Stripe Dashboard (Developers → API keys,
# turn "Test mode" ON). Secret key starts with sk_test_... (never commit real keys).
# STRIPE_SECRET_KEY=sk_test_...

# Optional but recommended: webhook secret so we record payments and update balance.
# For test mode: add a webhook in Stripe Dashboard → Developers → Webhooks (test),
# point to https://your-app/api/stripe/webhook, get the signing secret whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Set to true when using test keys so the UI can show "Test mode" (no real charges).
# NEXT_PUBLIC_STRIPE_TEST_MODE=true

# Dev-only: show hover hints in the UI (data source, API, behavior). Never ships — disabled in production.
# NEXT_PUBLIC_DEV_HINTS=true
