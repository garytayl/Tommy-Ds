# Copy to .env.local and set values. Feature switches turn on when vars are set.
# See lib/config.ts for which vars drive which features.

# -----------------------------------------------------------------------------
# Supabase — set URL + anon key for the app (session + RLS). Service role is optional.
# Project ref (CLI migrations): fhnkvhnnftwdtyxwspit — run `npx supabase login` then `npm run db:link`.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://fhnkvhnnftwdtyxwspit.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: local seed scripts and Admin → Team (auth.admin invite/delete). Not used for normal app CRUD.
# SUPABASE_SERVICE_ROLE_KEY=

# App URL (recommended for invite/callback redirects in production)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# Stripe (optional): required for isolated payment links in Admin → Billings
# and Jobs → Billings tab.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Dev-only: show hover hints in the UI (data source, API, behavior). Never ships — disabled in production.
# NEXT_PUBLIC_DEV_HINTS=true
